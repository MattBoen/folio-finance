{
  "name": "finance-client-backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx src/db/migrate.ts",
    "db:studio": "drizzle-kit studio",
    "test:unit": "vitest run -c vitest.unit.config.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "1.3.0",
    "@hono/node-server": "^2.1.5",
    "@hono/zod-validator": "^0.9.1",
    "bcryptjs": "^2.4.3",
    "drizzle-orm": "^0.45.4",
    "hono": "^4.6.0",
    "jose": "^5.9.0",
    "pg": "^8.13.0",
    "pg-boss": "^10.1.0",
    "plaid": "^28.0.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/pg": "^8.11.10",
    "@types/supertest": "^6.0.2",
    "drizzle-kit": "^0.31.11",
    "supertest": "^7.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "vitest": "^5.0.5"
  }
}
