# Copy to .env and fill in values. Never commit .env.

# Database
DATABASE_URL=postgresql://user:password@localhost:5432/finance_client

# JWT secrets — generate with: openssl rand -hex 32
JWT_ACCESS_SECRET=replace_with_64_char_hex
JWT_REFRESH_SECRET=replace_with_64_char_hex

# Plaid access token encryption key — generate with: openssl rand -hex 32
ENCRYPTION_KEY=replace_with_64_char_hex

# Plaid (create a separate app at dashboard.plaid.com)
PLAID_CLIENT_ID=
PLAID_SECRET=
PLAID_ENV=sandbox

# Apple Sign In
APPLE_BUNDLE_ID=com.yourcompany.financeclient

# Misc
PORT=4000
NODE_ENV=development
ALLOWED_ORIGINS=http://localhost:4000

# Ask Folio assistant (opt-in per user). Leave the key empty to disable it server-wide.
ANTHROPIC_API_KEY=
ASK_MODEL=claude-sonnet-5-5
ASK_DAILY_LIMIT=30
